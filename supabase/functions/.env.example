IMGBB_API_KEY=your-imgbb-api-key
# Journal e-mails via Resend (https://resend.com). MAIL_FROM moet een geverifieerd domein gebruiken.
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=Nefertem <journal@jouwdomein.be>
# Optioneel: adres waar antwoorden op de journal-mails terechtkomen.
MAIL_REPLY_TO=info@jouwdomein.be
# Publieke adres van de website, zonder # of ?, bijvoorbeeld https://jouwnaam.github.io/nefertem/
SITE_URL=https://jouwdomein.be/
# Inbox in de beheeromgeving (functie 'mail'). Afzender voor persoonlijke e-mails en antwoorden;
# laat leeg om MAIL_FROM te gebruiken. Ontvangen gebeurt op hetzelfde domein via een MX-record bij Resend.
MAIL_INBOX_FROM=Veronique Wostyn <info@jouwdomein.be>
# Resend-sleutel met "Full access" voor de inbox (ontvangen mail lezen). Een sleutel met alleen
# "Sending access" volstaat niet. Leeg laten = RESEND_API_KEY gebruiken.
RESEND_INBOX_API_KEY=re_your-full-access-key
# Signing secret van de Resend-webhook (event email.received), begint met whsec_.
RESEND_WEBHOOK_SECRET=whsec_your-webhook-secret
